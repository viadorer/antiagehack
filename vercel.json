{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ],
  "redirects": [
    { "source": "/dashboard", "destination": "/app/dashboard", "permanent": false },
    { "source": "/biometrics", "destination": "/app/biometrics", "permanent": false },
    { "source": "/protocol", "destination": "/app/protocol", "permanent": false },
    { "source": "/privacy", "destination": "/legal/privacy", "permanent": false },
    { "source": "/terms", "destination": "/legal/terms", "permanent": false },
    { "source": "/kontakt", "destination": "/legal/contact", "permanent": false }
  ]
}
